{
  "name": "telescope-toc",
  "version": "0.1.0",
  "description": "A Table of Contents source plugin for Telescope",
  "keywords": [
    "outline",
    "telescope",
    "toc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkdropapp/plugins.git",
    "directory": "packages/telescope-toc"
  },
  "main": "./lib/index.js",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@inkdropapp/types": "catalog:",
    "@types/react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "inkdrop": "^6.x"
  },
  "styleSheets": [
    "styles/toc.css"
  ]
}
