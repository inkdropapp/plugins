{
  "name": "telescope-themes",
  "version": "0.1.0",
  "description": "Switch between installed themes from Telescope, with a light/dark toggle command",
  "keywords": [
    "dark-mode",
    "telescope",
    "theme",
    "themes"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkdropapp/plugins.git",
    "directory": "packages/telescope-themes"
  },
  "main": "./lib/index",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@inkdropapp/types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "inkdrop": "^6.0.0"
  },
  "configSchema": {
    "lightTheme": {
      "title": "Light theme",
      "description": "Theme activated when toggling from a dark theme. Updated automatically when you pick a light theme.",
      "type": "string",
      "default": "default-light"
    },
    "darkTheme": {
      "title": "Dark theme",
      "description": "Theme activated when toggling from a light theme. Updated automatically when you pick a dark theme.",
      "type": "string",
      "default": "default-dark"
    }
  },
  "styleSheets": [
    "telescope-themes.css"
  ]
}
