{
  "name": "embed-gist",
  "version": "1.0.0",
  "description": "Embed GitHub Gists in Inkdrop notes",
  "keywords": [
    "embed",
    "gist",
    "github"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkdropapp/plugins.git",
    "directory": "packages/embed-gist"
  },
  "main": "./lib/index.js",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run lint && pnpm run build"
  },
  "devDependencies": {
    "@inkdropapp/types": "catalog:",
    "@types/react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "inkdrop": "^6.x"
  }
}
