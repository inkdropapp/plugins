{
  "name": "mermaid",
  "version": "4.0.1",
  "description": "Lets you draw diagrams and flowcharts with Mermaid",
  "keywords": [
    "inkdrop",
    "mermaid"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkdropapp/plugins.git",
    "directory": "packages/mermaid"
  },
  "main": "./lib/index",
  "scripts": {
    "dev": "pnpm copy-styles && tsdown --watch",
    "build": "pnpm copy-styles && tsdown",
    "copy-styles": "node ./scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm --filter mermaid... run build"
  },
  "devDependencies": {
    "@inkdropapp/mermaid": "workspace:^",
    "@inkdropapp/types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "katex": "catalog:",
    "pele": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "inkdrop": "^6.0.0"
  },
  "builtin": true,
  "styleSheets": [
    "mermaid.css",
    "fullscreen.css"
  ]
}
