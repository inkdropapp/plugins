{
  "name": "export-print",
  "version": "2.2.0",
  "description": "Print and export notes as PDF",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkdropapp/plugins.git",
    "directory": "packages/export-print"
  },
  "main": "./lib/index.js",
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run lint && pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@inkdropapp/types": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "inkdrop": "^6.x"
  },
  "styleSheets": [
    "index.css"
  ]
}
