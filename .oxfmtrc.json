{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "**/lib/**",
    "**/dist/**",
    "**/palette.json",
    "pnpm-lock.yaml",
    "tools/ipm-cli/templates/**"
  ]
}
