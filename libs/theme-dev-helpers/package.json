{
  "name": "@inkdropapp/theme-dev-helpers",
  "version": "0.7.1",
  "description": "A helper module for creating themes for Inkdrop",
  "keywords": [
    "inkdrop",
    "markdown"
  ],
  "license": "MIT",
  "author": "Takuya Matsuyama<t@inkdrop.app>",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkdropapp/plugins.git",
    "directory": "libs/theme-dev-helpers"
  },
  "bin": {
    "dev-server": "./bin/dev-server",
    "generate-palette": "./bin/generate-palette"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@inkdropapp/base-ui-theme": "^0.7.8",
    "@inkdropapp/css": "^0.9.14",
    "@vitejs/plugin-react": "^6.1.2",
    "commander": "^15.0.0",
    "puppeteer": "^25.13.0",
    "react": "catalog:",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "catalog:",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
